# Anthropic API Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Application Configuration
SECRET_KEY=your_secret_key_here
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/computer_use_db
DATABASE_URL_ASYNC=postgresql+asyncpg://postgres:password@localhost:5432/computer_use_db

# Server Configuration
HOST=0.0.0.0
PORT=8000
WORKERS=1

# VNC Configuration
VNC_HOST=localhost
VNC_PORT=5900
VNC_PASSWORD=password

# WebSocket Configuration
WS_HEARTBEAT_INTERVAL=30
WS_MAX_CONNECTIONS=100

# Redis Configuration (optional, for production scaling)
REDIS_URL=redis://localhost:6379

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
ALLOWED_HEADERS=*

# File Upload Configuration
MAX_FILE_SIZE=10485760  # 10MB
UPLOAD_DIRECTORY=./uploads

# Computer Use Configuration
COMPUTER_USE_ENABLED=true
SCREENSHOT_DELAY=1.0
MAX_TOOL_CALLS=50

# Session Configuration
SESSION_TIMEOUT=3600  # 1 hour
MAX_SESSIONS_PER_USER=10

# Development Configuration
RELOAD=true
ACCESS_LOG=true